# токен от @BotFather
BOT_TOKEN=123456:ABC...
# публичный HTTPS-адрес, по которому Telegram откроет мини-апп (сервер слушает PORT)
WEBAPP_URL=https://finconverter.example.com
# если Telegram недоступен напрямую: http://127.0.0.1:порт или socks5://127.0.0.1:порт
# PROXY_URL=
# Telegram id через запятую: только они могут пользоваться ботом, мини-аппом и командой /update.
# Пока пусто, бот закрыт для всех и на любое сообщение подсказывает id отправителя.
ADMIN_IDS=
# распознавание текста: сколько страниц считается одновременно и сколько страниц в сутки на человека
# OCR_WORKERS=2
# OCR_DAILY_PAGES=100
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
MAX_ITEMS=100
# только для отладки: открыть мини-апп в браузере без Telegram от имени этого user id
# DEV_USER_ID=123456789
