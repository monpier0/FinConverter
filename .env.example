# токен от @BotFather
BOT_TOKEN=123456:ABC...
# публичный HTTPS-адрес, по которому Telegram откроет мини-апп (сервер слушает PORT)
WEBAPP_URL=https://finconverter.example.com
# если Telegram недоступен напрямую: http://127.0.0.1:порт или socks5://127.0.0.1:порт
# PROXY_URL=
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
MAX_ITEMS=100
# только для отладки: открыть мини-апп в браузере без Telegram от имени этого user id
# DEV_USER_ID=123456789
